# 이 파일을 .env로 복사하고 값을 채운다. .env는 git에 올리지 않는다.

# --- OpenAI ---
OPENAI_API_KEY=
# 전체 실행에 쓸 모델. 모델 비교 결과를 보고 정한다. 가격은 오답 분석/코드/model_prices.json
OPENAI_MODEL=gpt-6.1-sol
# reasoning 모델의 추론 강도(low/medium/high). reasoning을 지원하지 않는 모델이면 비워 둔다.
OPENAI_REASONING_EFFORT=medium
# 응답 최대 토큰(추론 토큰 포함). 응답 미완료 오류가 나면 늘린다.
OPENAI_MAX_OUTPUT_TOKENS=16000
# OpenAI 측에 응답을 저장할지 여부. 기업 데이터이므로 기본 false.
OPENAI_STORE=false
# 프록시·Azure 호환 엔드포인트를 쓸 때만 지정
OPENAI_BASE_URL=

# --- 실행 ---
# 동시 요청 수. rate limit 오류가 잦으면 낮춘다.
ANALYSIS_CONCURRENCY=4
# 문항·검증 실패 시 재시도 횟수(SDK의 네트워크 재시도와 별개)
ANALYSIS_MAX_ATTEMPTS=3
# 원본 문제 PNG를 함께 보낼지 여부(1/0). CHUNJAE_RAW_ROOT가 있어야 동작한다.
ANALYSIS_ATTACH_IMAGES=1
# 별도 제공받은 원본 폴더(1학년 1학기 문제 이미지/ 포함). 전처리 테스트와 같은 변수.
CHUNJAE_RAW_ROOT=

# --- 모델 비교(benchmark_models.py) ---
# "모델:추론강도" 쉼표 구분. 추론강도를 비우면("모델:") reasoning 파라미터를 보내지 않는다.
BENCHMARK_MODELS=gpt-6.1-sol:medium,gpt-6-luna:medium,gpt-5.4-mini:medium,gpt-5-mini:medium
BENCHMARK_N_ITEMS=10
