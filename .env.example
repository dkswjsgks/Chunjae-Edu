# 이 파일을 .env로 복사하고 값을 채운다. .env는 git에 올리지 않는다.

# --- OpenAI (GPT) ---
OPENAI_API_KEY=
# 매핑 등 일반 호출 모델
OPENAI_MODEL=
# 추론 강도(low/medium/high). reasoning을 지원하지 않는 모델이면 비워 둔다
OPENAI_REASONING_EFFORT=
# 응답 최대 토큰(추론 토큰 포함)
OPENAI_MAX_OUTPUT_TOKENS=16000
# OpenAI 측 응답 저장 여부. 기업 데이터이므로 false
OPENAI_STORE=false
# 프록시·Azure 호환 엔드포인트를 쓸 때만
OPENAI_BASE_URL=
# 2단계 버전2 토큰 확률 점수용 모델. 추론 모델은 logprobs를 주지 않으므로 비추론 모델을 쓴다(비우면 OPENAI_MODEL)
OPENAI_SCORE_MODEL=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 추론 강도(low/medium/high/xhigh/max). claude-opus-5-5 기본은 medium이므로 명시한다
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000
# 거절 시 서버 측 대체 모델로 재실행(default) / 끄기(off)
ANTHROPIC_FALLBACK=default

# --- 데이터 위치 ---
# 별도 제공받은 원본 폴더(문항_샘플.csv, 문제 이미지)
CHUNJAE_RAW_ROOT=
# 11/18 받은 추가 데이터 2종 폴더
CHUNJAE_EXTRA_ROOT=
